  "hansa.old_hand": {
   "kind": "event",
   "arc": "hansa",
   "act": 1,
   "title": "An old hand",
   "requires": {
    "at_type": "Planet",
    "visiting_captain": {
     "game": "cargo1",
     "same_name": false
    }
   },
   "text": [
    "An old captain sits under the founders' wall, telling the young haulers how it was before the needles: {visitor.name}, {visitor.rank}, forty years retired.",
    "'The middle of the file,' {visitor.name} tells you. 'Always the middle, until you can afford to be wrong.'"
   ],
   "chance": 0.3,
   "choices": [
    {
     "id": "drink",
     "say": "Buy the old hand a drink",
     "requires": {
      "money": 200
     },
     "effects": {
      "money": -200,
      "standing.hansa": 5,
      "plot_points": 2
     }
    },
    {
     "id": "listen",
     "say": "Listen, and go to your slot"
    }
   ]
  },
  "rumour.gamma_coop": {
   "kind": "rumour",
   "arc": "2460",
   "act": 1,
   "requires": {
    "player_origin": {
     "flag": "gamma_farms_coop"
    }
   },
   "text": "Gamma's underground farms feed three systems now. The miners' cooperative keeps an empty chair at its meetings for the captain who signed the farms over."
  },
  "rumour.gamma_company": {
   "kind": "rumour",
   "arc": "2460",
   "act": 1,
   "requires": {
    "player_origin": {
     "flag": "gamma_farms_company"
    }
   },
   "text": "Gamma is a company town: the farms, the shafts and the canteen belong to one board. The miners call the farms 'the captain's gift', and they do not mean it kindly."
  },
  "rumour.harp": {
   "kind": "rumour",
   "arc": "2460",
   "act": 1,
   "requires": {
    "player_origin": {
     "flag": "harp_relay"
    }
   },
   "text": "The quantum harp has forty strings now. The Hansa's forecasts come from it, and the Mandate would very much like to know how."
  },
  "rumour.insured": {
   "kind": "rumour",
   "arc": "2460",
   "act": 1,
   "requires": {
    "player_origin": {
     "flag": "convoys_insured"
    }
   },
   "text": "Every needle leaves insured. The underwriters have done well out of it for forty years, and they still tell the story of the flare lane."
  },
  "rumour.bekkenheim": {
   "kind": "rumour",
   "arc": "2460",
   "act": 1,
   "text": "House Bekkenheim licenses the resonance every lead hauler jumps on. Fly past the Bekkenheim limit without a licence and you are a pirate, whatever you carry."
  },
  "rumour.lighthouse": {
   "kind": "rumour",
   "arc": "2460",
   "act": 1,
   "text": "Every jump shows on the Mandate's gravity-wave observatories like a lighthouse. Smugglers fly decoys. The Mandate counts the decoys too."
  },
  "rumour.tithe": {
   "kind": "rumour",
   "arc": "2460",
   "act": 1,
   "text": "The Cargolytes work the tail of every needle. Now and then they cut a container loose and call it the tithe. Some captains pay before they are asked."
  },
  "rumour.santor": {
   "kind": "rumour",
   "arc": "2460",
   "act": 1,
   "text": "The drive in every lead hauler carries {santor}'s name. Ask at the needle office why, and the clerks change the subject."
  },
  "rumour.jump_clocks": {
   "kind": "rumour",
   "arc": "2460",
   "act": 1,
   "text": "A jump takes minutes aboard and years outside. Haulers keep two clocks, and argue about which one the loan is on."
  },
  "rumour.mandate": {
   "kind": "rumour",
   "arc": "2460",
   "act": 1,
   "text": "The Mandate's needles go first, and their decoys go first too. Civilian needles wait at the departure buoy while the grey ships form up."
  }
 }
}
